{
  "service_id": "chat_server",
  "description": "Chat orchestration service for project and thread management, runtime chat configuration, and streaming conversation execution.",
  "service_name": "chat_server",
  "version": "1.0.0",
  "visibility": "public",
  "entry": {
    "args": [
      "-addr",
      "127.0.0.1:18082",
      "-config",
      "services/chat_server/config/configx.json",
      "-public-config",
      "services/chat_server/config/config.json",
      "-model",
      "doubao"
    ],
    "env": {}
  },
  "lifecycle": {
    "register_timeout_ms": 5000,
    "restart_policy": "never",
    "restart_backoff_ms": 300,
    "restart_times": 3
  }
}
