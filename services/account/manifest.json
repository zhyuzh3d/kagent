{
  "service_id": "account",
  "service_name": "Account Service",
  "version": "1.0.0",
  "visibility": "internal",
  "entry": {
    "args": [
      "-addr",
      "127.0.0.1:18083"
    ],
    "env": {}
  },
  "lifecycle": {
    "register_timeout_ms": 5000,
    "restart_policy": "never",
    "restart_backoff_ms": 300,
    "restart_times": 3,
    "kill_old": true
  }
}
