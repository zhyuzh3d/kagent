{
  "service_id": "account",
  "description": "Identity and session service for user authentication, profile access, password updates, public key discovery, and active session inspection.",
  "service_name": "Account Service",
  "version": "1.0.0",
  "visibility": "internal",
  "depends_on": [
    "sql_db"
  ],
  "entry": {
    "args": [
      "-addr",
      "127.0.0.1:18083"
    ],
    "env": {}
  },
  "lifecycle": {
    "register_timeout_ms": 5000,
    "restart_policy": "never",
    "restart_backoff_ms": 300,
    "restart_times": 3
  }
}
