{
  "service_id": "file_storage",
  "description": "Storage service for scoped file operations, blob upload and retrieval, signed download URLs, and blob garbage collection.",
  "service_name": "file_storage",
  "version": "1.0.0",
  "visibility": "public",
  "entry": {
    "args": [
      "-addr",
      "127.0.0.1:18084"
    ],
    "env": {}
  },
  "lifecycle": {
    "register_timeout_ms": 5000,
    "restart_policy": "never",
    "restart_backoff_ms": 300,
    "restart_times": 3
  }
}
