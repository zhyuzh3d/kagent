{
  "service_id": "surface_manager",
  "description": "Surface management service for catalog discovery, runtime state inspection, enable toggles, session issuance, and capability grants.",
  "service_name": "surface_manager",
  "version": "1.0.0",
  "visibility": "public",
  "depends_on": [
    "sql_db"
  ],
  "entry": {
    "args": [
      "-addr",
      "127.0.0.1:18086"
    ],
    "env": {}
  },
  "lifecycle": {
    "register_timeout_ms": 5000,
    "restart_policy": "never",
    "restart_backoff_ms": 300,
    "restart_times": 3
  }
}
